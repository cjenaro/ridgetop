{
  "name": "ridgetop",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "playtest": "node starter/serve.ts --testing",
    "preview-art": "node starter/preview-art.ts",
    "art-library": "node starter/art-library.ts",
    "test": "node --test test/*.test.ts",
    "test:browser": "node tools/browser-smoke.ts",
    "test:review": "node tools/art-review-smoke.ts",
    "test:player": "node tools/player-smoke.ts",
    "create-game": "node tools/create-game.ts",
    "package": "node tools/package-game.ts",
    "compile:godot": "node tools/ts-to-gd.ts",
    "generate:sprites": "node tools/generate-sprites.ts",
    "verify": "node tools/verify-game.ts",
    "feel": "node tools/tune-jumps.ts",
    "build": "tsc -p tsconfig.build.json && node tools/build-workshop.ts && node tools/build-player.ts && node tools/build-models.ts",
    "typecheck": "tsc -p tsconfig.json",
    "start:bun": "bun dist/server.js",
    "start:deno": "deno run --allow-read --allow-write --allow-net --allow-env dist/server.js",
    "prepack": "npm run build",
    "test:runtimes": "node tools/runtime-smoke.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "version": "1.0.0",
  "description": "Dependency-free low-poly WebGPU game framework and multiplayer platformer",
  "exports": {
    ".": {
      "types": "./dist/framework/index.d.ts",
      "default": "./dist/framework/index.js"
    },
    "./server": {
      "types": "./dist/framework/server.d.ts",
      "default": "./dist/framework/server.js"
    },
    "./ui": {
      "types": "./dist/framework/ui.d.ts",
      "default": "./dist/framework/ui.js"
    },
    "./art-review": {
      "types": "./dist/framework/art-review.d.ts",
      "default": "./dist/framework/art-review.js"
    },
    "./art-review/server": {
      "types": "./dist/framework/review-store.d.ts",
      "default": "./dist/framework/review-store.js"
    }
  },
  "files": [
    "framework",
    "game",
    "server.ts",
    "main.ts",
    "index.html",
    "style.css",
    "game-ui.css",
    "benchmark.html",
    "benchmark.ts",
    "sprite-workshop.html",
    "sprite-workshop.css",
    "sprite-workshop.ts",
    "sprite-model-editor.ts",
    "AGENTS.md",
    "test",
    "tools",
    "dist",
    "racing",
    "models",
    "starter",
    "racing.html",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "@webgpu/types": "0.1.74",
    "typescript": "5.9.3"
  }
}
