{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types"],
    "module": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true
  },
  "include": ["*.ts"],
  "exclude": ["dist", "node_modules"]
}
