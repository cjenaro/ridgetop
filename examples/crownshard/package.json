{
  "name": "@ridgetop/crownshard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "ridgetop": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:testing": "node dist/server.js --testing",
    "package": "ridgetop package --project ."
  },
  "ridgetop": {
    "name": "Crownshard",
    "appId": "com.ridgetop.crownshard",
    "html": "index.html",
    "moduleRoot": "dist",
    "entry": "crownshard/main.js",
    "staticFiles": ["game-ui.css"],
    "assetsModule": "dist/crownshard/package-assets.js",
    "godotEntries": [
      "crownshard/action-camera.ts",
      "crownshard/armory-diff.ts",
      "crownshard/auto-battle.ts",
      "crownshard/codex.ts",
      "crownshard/combat-log.ts",
      "crownshard/discovery-tips.ts",
      "crownshard/endless-roguelite.ts",
      "crownshard/expansion-act1.ts",
      "crownshard/simulation.ts",
      "crownshard/expansion-act2.ts",
      "crownshard/enemy-archetypes.ts",
      "crownshard/expansion-endgame.ts",
      "crownshard/expansion-frontier.ts",
      "crownshard/forge.ts",
      "crownshard/grid-cursor.ts",
      "crownshard/passives.ts",
      "crownshard/counter-attack.ts",
      "crownshard/elemental-combos.ts",
      "crownshard/forced-movement.ts",
      "crownshard/leveling.ts",
      "crownshard/inventory-ops.ts",
      "crownshard/mastery.ts",
      "crownshard/mutators.ts",
      "crownshard/pincer.ts",
      "crownshard/world-events.ts",
      "crownshard/zoc.ts",
      "crownshard/data.ts",
      "crownshard/types.ts",
      "ridgetop/ui"
    ]
  }
}
